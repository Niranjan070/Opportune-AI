# ==========================================
# Opportune AI Environment Configuration
# ==========================================

# Application
APP_NAME=Opportune AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (SQLite default for development; PostgreSQL for production)
DATABASE_URL=sqlite:///./opportune.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/opportune_ai

# Schedule Settings (Default: 9:00 AM Asia/Kolkata)
SCHEDULE_CRON=0 9 * * *
SCHEDULE_TIMEZONE=Asia/Kolkata
SCHEDULE_ENABLED=true

# AI Provider Configuration (Optional - deterministic fallback available)
LLM_PROVIDER=mock
# Options: mock, openai, gemini, anthropic
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Email Delivery Configuration (Direct Provider)
EMAIL_PROVIDER=console
# Options: console, smtp, resend
EMAIL_FROM=Opportune AI <digest@opportune.ai>
DEFAULT_RECIPIENT_EMAIL=user@example.com
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# MCP Configuration
MCP_SERVER_COMMAND=python -m backend.mcp_server.server
MCP_TIMEOUT_SECONDS=20
BRAVE_API_KEY=
